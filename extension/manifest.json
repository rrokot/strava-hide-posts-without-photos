{
  "manifest_version": 3,
  "name": "Strava Feed Filters",
  "version": "5.53.0",
  "description": "Filter the Strava feed by activity type, media, virtual activities, kudos, and ownership.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "64": "icon-64.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.strava.com/dashboard*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "strava-feed-filters@rrokot.github.io",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {}
  }
}
