{
  "manifest_version": 3,
  "name": "Strava Feed Filters",
  "version": "5.52.0",
  "description": "Hide photo-less, virtual, liked, and own posts in the Strava feed.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "64": "icon-64.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.strava.com/dashboard*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
